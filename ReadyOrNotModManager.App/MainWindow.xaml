<Window x:Class="ReadyOrNotModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ready or Not Mod Manager" Height="760" Width="1180" MinHeight="660" MinWidth="980"
        WindowState="Maximized"
        Background="#111512">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B211D"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#222922"/>
        <SolidColorBrush x:Key="LineBrush" Color="#344037"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6ECE4"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A8B2A8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D7C35C"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#101410"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,6,0,12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#101410"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#2B342D"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="#171C18"/>
            <Setter Property="AlternatingRowBackground" Value="#1D241F"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2F3932"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Ready or Not" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Nexus mod deployment queue" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,22"/>

                    <TextBlock Text="Nexus API key" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="ApiKeyBox"/>
                    <WrapPanel>
                        <Button Content="Save settings" Click="SaveSettings_Click" Background="#3A3F28" BorderBrush="{StaticResource AccentBrush}"/>
                        <Button Content="Get API key" Click="OpenApiKeyPage_Click"/>
                    </WrapPanel>
                    <CheckBox x:Name="AdvancedOptionsBox" Content="Advanced options" Foreground="{StaticResource TextBrush}" Margin="0,4,0,8"/>

                    <Separator Margin="0,16,0,16" Background="{StaticResource LineBrush}"/>

                    <TextBlock Text="Download folder" FontWeight="SemiBold"/>
                    <TextBox x:Name="DownloadDirectoryBox"/>
                    <WrapPanel>
                        <Button Content="Choose download folder" Click="BrowseDownloadDirectory_Click"/>
                        <Button Content="Open folder" Click="OpenDownloadDirectory_Click"/>
                    </WrapPanel>

                    <TextBlock Text="Ready or Not install folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <TextBox x:Name="GameDirectoryBox"/>
                    <Button Content="Choose game folder" Click="BrowseGameDirectory_Click"/>

                    <TextBlock Text="Browser fallback import folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <TextBox x:Name="ImportDirectoryBox"/>
                    <Button Content="Choose import folder" Click="BrowseImportDirectory_Click"/>

                    <TextBlock Text="Modpack library folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <TextBox x:Name="ProfileLibraryDirectoryBox"/>
                    <WrapPanel>
                        <Button Content="Choose library folder" Click="BrowseProfileLibraryDirectory_Click"/>
                        <Button Content="Open library" Click="OpenProfileLibraryDirectory_Click"/>
                    </WrapPanel>

                    <Separator Margin="0,16,0,16" Background="{StaticResource LineBrush}"/>

                    <TextBlock Text="Add Nexus URL" FontWeight="SemiBold"/>
                    <TextBox x:Name="UrlBox" ToolTip="Paste a Ready or Not mod or collection URL"/>
                    <Button Content="Add to queue" Click="AddUrl_Click" Background="#3A3F28" BorderBrush="{StaticResource AccentBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Grid.Row="0" Margin="18,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Deployment queue" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Collections expand into individual Nexus files before download." Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Modpacks" Click="OpenProfiles_Click"/>
                    <Button Content="Errors" Click="OpenErrors_Click"/>
                    <Button Content="Clear completed" Click="ClearCompleted_Click"/>
                    <Button Content="Clear user data" Click="ClearUserData_Click"/>
                </WrapPanel>
            </DockPanel>
            <DataGrid x:Name="QueueGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mod" Binding="{Binding ModName}" Width="2*"/>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110"/>
                    <DataGridTextColumn Header="Mod ID" Binding="{Binding ModId}" Width="80"/>
                    <DataGridTextColumn Header="File ID" Binding="{Binding FileId}" Width="80"/>
                    <DataGridTextColumn Header="Archive" Binding="{Binding ArchivePath}" Width="2*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" Grid.Row="1" Margin="18,14,0,0" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" CornerRadius="6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Download missing" Click="DownloadMissing_Click" Background="#3A3F28" BorderBrush="{StaticResource AccentBrush}"/>
                    <Button Content="Open Nexus page" Click="OpenSelectedPage_Click"/>
                    <Button Content="Import archive" Click="ImportArchive_Click"/>
                    <Button Content="Delete download" Click="DeleteDownloadedArchive_Click"/>
                    <Button Content="Deploy selected" Click="DeploySelected_Click"/>
                    <Button Content="Uninstall selected" Click="UninstallSelected_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ProgressBar x:Name="OverallProgressBar" Width="180" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,0,12,0"/>
                    <TextBlock x:Name="ProgressText" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
