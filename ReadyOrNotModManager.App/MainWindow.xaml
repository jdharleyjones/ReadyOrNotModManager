<Window x:Class="ReadyOrNotModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:services="clr-namespace:ReadyOrNotModManager.App.Services"
        Title="Ready or Not Mod Manager" Height="820" Width="1320" MinHeight="720" MinWidth="1080"
        WindowState="Maximized"
        Background="{DynamicResource ShellBrush}">
    <Window.Resources>
        <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0E1113" Offset="0"/>
            <GradientStop Color="#161D21" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RailBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#14191D" Offset="0"/>
            <GradientStop Color="#1F282E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B2226" Offset="0"/>
            <GradientStop Color="#29343A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PanelAltBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#222B30" Offset="0"/>
            <GradientStop Color="#303C42" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="LineBrush" Color="#334149"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8ECEB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A3AFB0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#C7A957"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#6FA8C9"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#D77766"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#7EB386"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D6A84F"/>
        <SolidColorBrush x:Key="InactiveBrush" Color="#6F7A82"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#43515A" Opacity="0.68"/>
        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D91B252B" Offset="0"/>
            <GradientStop Color="#A8141B21" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardAltBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0222D34" Offset="0"/>
            <GradientStop Color="#AA141A20" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="GlowBlueBrush" Center="0.18,0.08" GradientOrigin="0.18,0.08" RadiusX="0.78" RadiusY="0.62">
            <GradientStop Color="#304E86B8" Offset="0"/>
            <GradientStop Color="#0010161A" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GlowAmberBrush" Center="0.9,0.2" GradientOrigin="0.9,0.2" RadiusX="0.64" RadiusY="0.54">
            <GradientStop Color="#22C7A957" Offset="0"/>
            <GradientStop Color="#0010161A" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="VignetteBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.72" RadiusY="0.78">
            <GradientStop Color="#00000000" Offset="0"/>
            <GradientStop Color="#B8000000" Offset="1"/>
        </RadialGradientBrush>
        <services:QueueStatusLabelConverter x:Key="QueueStatusLabelConverter"/>
        <services:QueueStatusIconConverter x:Key="QueueStatusIconConverter"/>
        <services:QueueStatusBrushConverter x:Key="QueueStatusBrushConverter"/>
        <services:VisualToneBrushConverter x:Key="VisualToneBrushConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="SectionEyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.28"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="#AA0F161C"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid Margin="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                                <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Foreground="{DynamicResource MutedBrush}" Opacity="0.72" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                                <Setter TargetName="Watermark" Property="Opacity" Value="0.38"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="#AA0F161C"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#D01E2A32"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#6FA8C9" BlurRadius="13" ShadowDepth="0" Opacity="0.23"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="{DynamicResource InactiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B82B4D63"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#A9233D4D"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
        </Style>
        <Style x:Key="DownloadButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B820344B"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
        </Style>
        <Style x:Key="DeployButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B8233A2B"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B8472722"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style x:Key="SpecialButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B83A3524"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="RowBackground" Value="#66172229"/>
            <Setter Property="AlternatingRowBackground" Value="#88202B33"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E0141C22"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#553B5361"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#704D6A78"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left" CornerRadius="8,0,0,8" Background="{DynamicResource AccentBrush}" Opacity="0"/>
                                <ContentPresenter Margin="12,8,10,8" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#5530414B"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Chrome" Property="Background" Value="#77344650"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#665D7580"/>
                                <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="#D0141C22"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#66344650"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#88415A66"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,6,10,10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="#AA0F161C"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                        <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource MutedBrush}" Width="8" Height="5" Stretch="Fill" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" MinWidth="{TemplateBinding ActualWidth}" Padding="2">
                                    <ScrollViewer MaxHeight="260" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ShellBrush}">
        <Rectangle Fill="{StaticResource GlowBlueBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource GlowAmberBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource VignetteBrush}" IsHitTestVisible="False"/>
        <Grid x:Name="SetupRoot" Visibility="Collapsed" Margin="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource RailBrush}" Padding="34">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="READY OR NOT" FontSize="14" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Deployment station setup" FontSize="38" FontWeight="SemiBold" Margin="0,8,0,16"/>
                    <TextBlock Text="Connect Nexus, locate the game, and choose where archives and modpacks live. You only need this screen when setup is missing or reset." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="15"/>
                    <Border Margin="0,28,0,0" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1" Height="1"/>
                    <TextBlock Text="Status checks" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,10"/>
                    <TextBlock x:Name="SetupNexusStatusText" Text="Nexus connection not tested" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/>
                    <TextBlock x:Name="SetupGameStatusText" Text="Game folder not validated" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/>
                    <TextBlock x:Name="SetupFoldersStatusText" Text="Storage folders not validated" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="28" Margin="18,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Setup wizard" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Fields turn green when ready. You can change all of this later in Settings." Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,18"/>

                        <TextBlock Text="Nexus API key" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="SetupApiKeyBox"/>
                        <WrapPanel>
                            <Button Content="Get API Key" Click="OpenApiKeyPage_Click"/>
                            <Button Content="Test Connection" Click="TestConnection_Click" Style="{StaticResource PrimaryButton}"/>
                        </WrapPanel>

                        <TextBlock Text="Ready or Not install folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBox x:Name="SetupGameDirectoryBox"/>
                        <WrapPanel>
                            <Button Content="Choose game folder" Click="BrowseSetupGameDirectory_Click"/>
                            <Button Content="Auto-detect Game Folder" Click="AutoDetectGameFolder_Click"/>
                        </WrapPanel>

                        <TextBlock Text="Download folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBox x:Name="SetupDownloadDirectoryBox"/>
                        <Button Content="Choose download folder" Click="BrowseSetupDownloadDirectory_Click"/>

                        <TextBlock Text="Browser fallback import folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBox x:Name="SetupImportDirectoryBox"/>
                        <Button Content="Choose import folder" Click="BrowseSetupImportDirectory_Click"/>

                        <TextBlock Text="Modpack library folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBox x:Name="SetupProfileLibraryDirectoryBox"/>
                        <Button Content="Choose library folder" Click="BrowseSetupProfileLibraryDirectory_Click"/>

                        <DockPanel Margin="0,22,0,0">
                            <TextBlock x:Name="SetupMessageText" Text="" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <Button Content="Continue" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="ContinueSetup_Click" Style="{StaticResource PrimaryButton}"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="ShellRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#D4141B21" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="18">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="RON" FontSize="32" FontWeight="SemiBold"/>
                        <TextBlock Text="MOD CONTROL" Style="{StaticResource SectionEyebrow}" Margin="0,0,0,26"/>
                        <Button x:Name="DashboardNavButton" Style="{StaticResource NavButton}" Click="DashboardNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="ViewDashboardOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Dashboard"/></StackPanel>
                        </Button>
                        <Button x:Name="ModsNavButton" Style="{StaticResource NavButton}" Click="ModsNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="PackageVariantClosed" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Installed"/></StackPanel>
                        </Button>
                        <Button x:Name="QueueNavButton" Style="{StaticResource NavButton}" Click="QueueNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="PlaylistCheck" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Mods"/></StackPanel>
                        </Button>
                        <Button x:Name="ModpacksNavButton" Style="{StaticResource NavButton}" Click="ModpacksNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="FolderMultipleOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Modpacks"/></StackPanel>
                        </Button>
                        <Button x:Name="DownloadsNavButton" Style="{StaticResource NavButton}" Click="DownloadsNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="DownloadBoxOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Downloads"/></StackPanel>
                        </Button>
                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="SettingsNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="CogOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Settings"/></StackPanel>
                        </Button>
                        <Button x:Name="LogsNavButton" Style="{StaticResource NavButton}" Click="LogsNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Logs/Errors"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="CONNECTION STATUS" Style="{StaticResource SectionEyebrow}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial x:Name="RailGameStatusIcon" Kind="HelpCircleOutline" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,1,9,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Game" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                    <TextBlock x:Name="RailGameStatusText" Text="Unknown" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial x:Name="RailNexusStatusIcon" Kind="HelpCircleOutline" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,1,9,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nexus" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                    <TextBlock x:Name="RailNexusStatusText" Text="Unknown" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="34" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageSubtitleText" Text="Ready or Not mod deployment overview" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Columns="5" Margin="0,0,0,16">
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial x:Name="DashboardGameIcon" Kind="GamepadVariantOutline" Width="18" Height="18" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="GAME STATUS" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DashboardGameStatusText" Grid.Row="1" Text="Not detected" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,2"/>
                                        <TextBlock x:Name="DashboardGameHelperText" Grid.Row="2" Text="Choose or auto-detect the game folder" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial x:Name="DashboardNexusIcon" Kind="AccountQuestionOutline" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="NEXUS" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,10,0,2">
                                            <TextBlock x:Name="DashboardNexusPrefixText" Text="Correct:" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed"/>
                                            <TextBlock x:Name="DashboardNexusStatusText" Text="Not tested" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DashboardNexusHelperText" Grid.Row="2" Text="Run a connection test from Settings" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="PackageVariantClosed" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="INSTALLED" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="InstalledModCountText" Text="0" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                                        <TextBlock Text="Tracked deployed mods" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="PlaylistCheck" Width="18" Height="18" Foreground="{DynamicResource BlueBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="PENDING" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="PendingQueueCountText" Text="0" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}" Margin="0,8,0,0"/>
                                        <TextBlock Text="Queue items awaiting action" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial x:Name="DashboardUpdateIcon" Kind="Update" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="APP VERSION" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DashboardUpdateStatusText" Grid.Row="1" Text="Current: checking" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,2"/>
                                        <TextBlock x:Name="DashboardUpdateHelperText" Grid.Row="2" Text="Checking latest GitHub release" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Quick actions" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Paste a Nexus mod or collection URL, then queue, import, or deploy without leaving the dashboard." Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,12"/>
                                    <TextBox x:Name="UrlBox" Tag="input Nexus URL here..." ToolTip="Paste a Ready or Not mod or collection URL"/>
                                    <DockPanel LastChildFill="True">
                                        <Button Content="Run Game" Click="RunGame_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource DeployButton}"/>
                                        <WrapPanel>
                                            <Button Content="Add Nexus URL" Click="AddUrl_Click" Tag="{Binding ElementName=UrlBox}" Style="{StaticResource ActionButton}"/>
                                            <Button Content="Import Archive" Click="ImportArchive_Click" Style="{StaticResource ActionButton}"/>
                                            <Button Content="Deploy all downloaded" Click="DeployDownloaded_Click" Style="{StaticResource DeployButton}"/>
                                            <Button Content="Show Modpacks" Click="ModpacksNav_Click" Style="{StaticResource SpecialButton}"/>
                                            <Button Content="Nexus Mods" Click="OpenReadyOrNotModsPage_Click" Style="{StaticResource ActionButton}"/>
                                            <Button Content="Nexus Collections" Click="OpenReadyOrNotCollectionsPage_Click" Style="{StaticResource SpecialButton}"/>
                                            <Button Content="Open Mods Folder" Click="OpenModsFolder_Click" Style="{StaticResource ActionButton}"/>
                                            <Button Content="Open Game Folder" Click="OpenGameFolder_Click" Style="{StaticResource ActionButton}"/>
                                        </WrapPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Recent activity" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl x:Name="RecentActivityList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#66141C22" BorderBrush="#3343515A" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <iconPacks:PackIconMaterial Kind="{Binding Icon}" Width="18" Height="18" Foreground="{Binding Tone, Converter={StaticResource VisualToneBrushConverter}}" Margin="0,1,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ModsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                            <DataGrid x:Name="InstalledModsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mod" Binding="{Binding ModName}" Width="2*"/>
                                    <DataGridTextColumn Header="Archive" Binding="{Binding ArchivePath}" Width="2*"/>
                                    <DataGridTextColumn Header="Installed" Binding="{Binding InstalledAtUtc, StringFormat={}{0:g}}" Width="180"/>
                                    <DataGridTextColumn Header="Files" Binding="{Binding DeployedFiles.Count}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                            <Button Content="Uninstall selected" Click="UninstallInstalledSelected_Click" Style="{StaticResource DangerButton}"/>
                            <Button Content="Open Mods Folder" Click="OpenModsFolder_Click" Style="{StaticResource ActionButton}"/>
                        </WrapPanel>
                    </Grid>

                    <Grid x:Name="QueuePage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="QueueUrlBox" Tag="input Nexus URL here..." Margin="0,0,10,0" ToolTip="Paste a Ready or Not mod or collection URL"/>
                                <Button Grid.Column="1" Content="Add" Click="AddUrl_Click" Tag="{Binding ElementName=QueueUrlBox}" Style="{StaticResource PrimaryButton}" Margin="0,0,18,0"/>
                                <TextBox x:Name="QueueSearchBox" Grid.Column="2" Margin="0,0,10,0" ToolTip="Search queued mods" TextChanged="QueueFilter_Changed"/>
                                <ComboBox x:Name="QueueStatusFilterBox" Grid.Column="3" Margin="0,0,10,0" SelectionChanged="QueueFilter_Changed"/>
                                <TextBlock x:Name="QueueSummaryText" Grid.Column="4" Text="0 items" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                            <DataGrid x:Name="QueueGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mod" Binding="{Binding ModName}" Width="2*"/>
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110"/>
                                    <DataGridTextColumn Header="Mod ID" Binding="{Binding ModId}" Width="80"/>
                                    <DataGridTextColumn Header="File ID" Binding="{Binding FileId}" Width="80"/>
                                    <DataGridTextColumn Header="Archive" Binding="{Binding ArchivePath}" Width="2*"/>
                                    <DataGridTemplateColumn Header="Status" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="{Binding Status, Converter={StaticResource QueueStatusBrushConverter}}" Padding="8,3" HorizontalAlignment="Left" Background="#33141C22">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Kind="{Binding Status, Converter={StaticResource QueueStatusIconConverter}}" Width="13" Height="13" Foreground="{Binding Status, Converter={StaticResource QueueStatusBrushConverter}}" Margin="0,1,5,0"/>
                                                        <TextBlock Text="{Binding Status, Converter={StaticResource QueueStatusLabelConverter}}" Style="{StaticResource BadgeText}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,12,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button Content="Download missing" Click="DownloadMissing_Click" Style="{StaticResource DownloadButton}"/>
                                    <Button Content="Deploy selected" Click="DeploySelected_Click" Style="{StaticResource DeployButton}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0">
                                    <Button Content="Open Nexus page" Click="OpenSelectedPage_Click" Style="{StaticResource ActionButton}"/>
                                    <Button Content="Import archive" Click="ImportArchive_Click" Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Delete download" Click="DeleteDownloadedArchive_Click" Style="{StaticResource DangerButton}"/>
                                    <Button Content="Uninstall selected" Click="UninstallSelected_Click" Style="{StaticResource DangerButton}"/>
                                    <Button Content="Remove selected" Click="RemoveSelectedQueueItems_Click" Style="{StaticResource DangerButton}"/>
                                    <Button Content="Clear completed" Click="ClearCompleted_Click" Style="{StaticResource DangerButton}"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="ModpacksPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                            <DataGrid x:Name="ProfilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" AlternationCount="2" PreviewMouseRightButtonDown="ProfilesGrid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename modpack" Click="RenameProfile_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Mods" Binding="{Binding Items.Count}" Width="80"/>
                                    <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAtUtc, StringFormat={}{0:g}}" Width="180"/>
                                    <DataGridTextColumn Header="Profile ID" Binding="{Binding ProfileId}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <DockPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBox x:Name="ProfileNameBox" Width="260" DockPanel.Dock="Left" ToolTip="Profile name"/>
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Content="Save current as new" Click="SaveProfileNew_Click" Style="{StaticResource SpecialButton}"/>
                                <Button Content="Update selected" Click="UpdateProfileSelected_Click" Style="{StaticResource SpecialButton}"/>
                                <Button Content="Load selected" Click="LoadProfileSelected_Click" Style="{StaticResource ActionButton}"/>
                                <Button Content="Activate selected" Click="ActivateProfileSelected_Click" Style="{StaticResource DeployButton}"/>
                                <Button Content="Delete selected" Click="DeleteProfileSelected_Click" Style="{StaticResource DangerButton}"/>
                            </WrapPanel>
                        </DockPanel>
                    </Grid>

                    <ScrollViewer x:Name="DownloadsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Archive locations" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Manage retained downloads and browser fallback imports." Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,14"/>
                            <WrapPanel>
                                <Button Content="Open download folder" Click="OpenDownloadDirectory_Click" Style="{StaticResource ActionButton}"/>
                                <Button Content="Import archive" Click="ImportArchive_Click" Style="{StaticResource ActionButton}"/>
                                <Button Content="Delete selected download" Click="DeleteDownloadedArchive_Click" Style="{StaticResource DangerButton}"/>
                                <Button Content="Download missing queue items" Click="DownloadMissing_Click" Style="{StaticResource DownloadButton}"/>
                            </WrapPanel>
                            <Border Style="{StaticResource CardBorderStyle}" BorderBrush="{DynamicResource AccentBrush}" Padding="34" Margin="0,42,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="WIP" FontSize="72" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Downloads workspace is still being expanded." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="NEXUS CONNECTION" Style="{StaticResource SectionEyebrow}"/>
                                    <TextBlock Text="Nexus API key" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                    <PasswordBox x:Name="ApiKeyBox"/>
                                    <CheckBox x:Name="AutoTestNexusOnLaunchBox" Content="Auto-test Nexus connection on app launch"/>
                                    <WrapPanel><Button Content="Save settings" Click="SaveSettings_Click" Style="{StaticResource SpecialButton}"/><Button Content="Get API key" Click="OpenApiKeyPage_Click" Style="{StaticResource ActionButton}"/><Button Content="Test Connection" Click="TestConnection_Click" Style="{StaticResource DownloadButton}"/></WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="GAME FOLDERS" Style="{StaticResource SectionEyebrow}"/>
                                    <TextBlock Text="Ready or Not install folder" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                    <TextBox x:Name="GameDirectoryBox"/>
                                    <WrapPanel><Button Content="Choose game folder" Click="BrowseGameDirectory_Click" Style="{StaticResource ActionButton}"/><Button Content="Auto-detect Game Folder" Click="AutoDetectGameFolder_Click" Style="{StaticResource DownloadButton}"/><Button Content="Open game folder" Click="OpenGameFolder_Click" Style="{StaticResource ActionButton}"/></WrapPanel>

                                    <TextBlock Text="Download folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                    <TextBox x:Name="DownloadDirectoryBox"/>
                                    <WrapPanel><Button Content="Choose download folder" Click="BrowseDownloadDirectory_Click" Style="{StaticResource ActionButton}"/><Button Content="Open folder" Click="OpenDownloadDirectory_Click" Style="{StaticResource ActionButton}"/></WrapPanel>

                                    <TextBlock Text="Browser fallback import folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                    <TextBox x:Name="ImportDirectoryBox"/>
                                    <Button Content="Choose import folder" Click="BrowseImportDirectory_Click" Style="{StaticResource ActionButton}"/>

                                    <TextBlock Text="Modpack library folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                    <TextBox x:Name="ProfileLibraryDirectoryBox"/>
                                    <WrapPanel><Button Content="Choose library folder" Click="BrowseProfileLibraryDirectory_Click" Style="{StaticResource ActionButton}"/><Button Content="Open library" Click="OpenProfileLibraryDirectory_Click" Style="{StaticResource ActionButton}"/></WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionEyebrow}"/>
                                    <TextBlock Text="Colour scheme" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                    <ComboBox x:Name="ThemeSelector" DisplayMemberPath="DisplayName" SelectedValuePath="Name" SelectionChanged="ThemeSelection_Changed" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ADVANCED" Style="{StaticResource SectionEyebrow}"/>
                                    <CheckBox x:Name="AdvancedOptionsBox" Content="Advanced deploy options" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" BorderBrush="{DynamicResource DangerBrush}">
                                <StackPanel>
                                    <TextBlock Text="DANGER ZONE" Style="{StaticResource SectionEyebrow}" Foreground="{DynamicResource DangerBrush}"/>
                                    <TextBlock Text="Reset setup or clear local settings, queue, manifests, and logs." Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,8"/>
                                    <WrapPanel>
                                        <Button Content="Reset setup wizard" Click="ResetSetupWizard_Click" Style="{StaticResource SpecialButton}"/>
                                        <Button Content="Clear user data" Click="ClearUserData_Click" Style="{StaticResource DangerButton}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="LogsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                            <DataGrid x:Name="ErrorsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, StringFormat={}{0:g}}" Width="150"/>
                                    <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="120"/>
                                    <DataGridTextColumn Header="Mod" Binding="{Binding ModName}" Width="220"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*"/>
                                    <DataGridTextColumn Header="Archive" Binding="{Binding ArchivePath}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                            <Button Content="Open Nexus page" Click="OpenErrorNexus_Click" Style="{StaticResource ActionButton}"/>
                            <Button Content="Open game folder" Click="OpenErrorGameFolder_Click" Style="{StaticResource ActionButton}"/>
                            <Button Content="Open archive folder" Click="OpenErrorArchiveFolder_Click" Style="{StaticResource ActionButton}"/>
                            <Button Content="Copy manual fix note" Click="CopyErrorManualFix_Click" Style="{StaticResource SpecialButton}"/>
                            <Button Content="Clear errors" Click="ClearErrors_Click" Style="{StaticResource DangerButton}"/>
                        </WrapPanel>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}" Padding="12">
                    <DockPanel LastChildFill="True">
                        <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed">
                            <ProgressBar x:Name="OverallProgressBar" Width="420" Height="20" Minimum="0" Maximum="100" Value="0" Margin="0,0,16,0"/>
                            <TextBlock x:Name="ProgressText" Text="" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
