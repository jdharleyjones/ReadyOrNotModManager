<Window x:Class="ReadyOrNotModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Ready or Not Mod Manager" Height="820" Width="1320" MinHeight="720" MinWidth="1080"
        WindowState="Maximized"
        Background="#0E1113">
    <Window.Resources>
        <SolidColorBrush x:Key="ShellBrush" Color="#0E1113"/>
        <SolidColorBrush x:Key="RailBrush" Color="#14191D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B2226"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#222B30"/>
        <SolidColorBrush x:Key="LineBrush" Color="#334149"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8ECEB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A3AFB0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#C7A957"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#6FA8C9"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#D77766"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#7EB386"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Background" Value="#10161A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Background" Value="#10161A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#283238"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34434A"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3A3524"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="#172025"/>
            <Setter Property="AlternatingRowBackground" Value="#1C282E"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2D3A41"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202A30"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="SetupRoot" Visibility="Collapsed" Margin="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#12181C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="34">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="READY OR NOT" FontSize="14" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Deployment station setup" FontSize="38" FontWeight="SemiBold" Margin="0,8,0,16"/>
                    <TextBlock Text="Connect Nexus, locate the game, and choose where archives and modpacks live. You only need this screen when setup is missing or reset." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="15"/>
                    <Border Margin="0,28,0,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" Height="1"/>
                    <TextBlock Text="Status checks" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,10"/>
                    <TextBlock x:Name="SetupNexusStatusText" Text="Nexus connection not tested" Foreground="{StaticResource MutedBrush}" Margin="0,4"/>
                    <TextBlock x:Name="SetupGameStatusText" Text="Game folder not validated" Foreground="{StaticResource MutedBrush}" Margin="0,4"/>
                    <TextBlock x:Name="SetupFoldersStatusText" Text="Storage folders not validated" Foreground="{StaticResource MutedBrush}" Margin="0,4"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="28" Margin="18,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Setup wizard" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Fields turn green when ready. You can change all of this later in Settings." Foreground="{StaticResource MutedBrush}" Margin="0,2,0,18"/>

                        <TextBlock Text="Nexus API key" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="SetupApiKeyBox"/>
                        <WrapPanel>
                            <Button Content="Get API Key" Click="OpenApiKeyPage_Click"/>
                            <Button Content="Test Connection" Click="TestConnection_Click" Style="{StaticResource PrimaryButton}"/>
                        </WrapPanel>

                        <TextBlock Text="Ready or Not install folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBox x:Name="SetupGameDirectoryBox"/>
                        <WrapPanel>
                            <Button Content="Choose game folder" Click="BrowseSetupGameDirectory_Click"/>
                            <Button Content="Auto-detect Game Folder" Click="AutoDetectGameFolder_Click"/>
                        </WrapPanel>

                        <TextBlock Text="Download folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBox x:Name="SetupDownloadDirectoryBox"/>
                        <Button Content="Choose download folder" Click="BrowseSetupDownloadDirectory_Click"/>

                        <TextBlock Text="Browser fallback import folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBox x:Name="SetupImportDirectoryBox"/>
                        <Button Content="Choose import folder" Click="BrowseSetupImportDirectory_Click"/>

                        <TextBlock Text="Modpack library folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBox x:Name="SetupProfileLibraryDirectoryBox"/>
                        <Button Content="Choose library folder" Click="BrowseSetupProfileLibraryDirectory_Click"/>

                        <DockPanel Margin="0,22,0,0">
                            <TextBlock x:Name="SetupMessageText" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <Button Content="Continue" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="ContinueSetup_Click" Style="{StaticResource PrimaryButton}"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="ShellRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource RailBrush}" BorderBrush="#263239" BorderThickness="0,0,1,0" Padding="18">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="RON" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="Mod control" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,24"/>
                        <Button x:Name="DashboardNavButton" Style="{StaticResource NavButton}" Click="DashboardNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="ViewDashboardOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Dashboard"/></StackPanel>
                        </Button>
                        <Button x:Name="ModsNavButton" Style="{StaticResource NavButton}" Click="ModsNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="PackageVariantClosed" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Mods"/></StackPanel>
                        </Button>
                        <Button x:Name="QueueNavButton" Style="{StaticResource NavButton}" Click="QueueNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="PlaylistCheck" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Queue"/></StackPanel>
                        </Button>
                        <Button x:Name="ModpacksNavButton" Style="{StaticResource NavButton}" Click="ModpacksNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="FolderMultipleOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Modpacks"/></StackPanel>
                        </Button>
                        <Button x:Name="DownloadsNavButton" Style="{StaticResource NavButton}" Click="DownloadsNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="DownloadBoxOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Downloads"/></StackPanel>
                        </Button>
                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="SettingsNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="CogOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Settings"/></StackPanel>
                        </Button>
                        <Button x:Name="LogsNavButton" Style="{StaticResource NavButton}" Click="LogsNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="Logs/Errors"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="Game" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBlock x:Name="RailGameStatusText" Text="Not detected" TextWrapping="Wrap" Margin="0,3,0,12"/>
                        <TextBlock Text="Nexus" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBlock x:Name="RailNexusStatusText" Text="Not tested" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageSubtitleText" Text="Ready or Not mod deployment overview" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="Add Nexus URL" Click="DashboardNav_Click" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Settings" Click="SettingsNav_Click"/>
                    </WrapPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                                    <StackPanel><TextBlock Text="Game status" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashboardGameStatusText" Text="Not detected" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                                    <StackPanel><TextBlock Text="Nexus" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashboardNexusStatusText" Text="Not tested" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                                    <StackPanel><TextBlock Text="Installed mods" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="InstalledModCountText" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/></StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18">
                                    <StackPanel><TextBlock Text="Pending queue" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PendingQueueCountText" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}"/></StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Quick actions" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Paste a Nexus mod or collection URL, then queue, import, or deploy without leaving the dashboard." Foreground="{StaticResource MutedBrush}" Margin="0,2,0,12"/>
                                    <TextBox x:Name="UrlBox" ToolTip="Paste a Ready or Not mod or collection URL"/>
                                    <WrapPanel>
                                        <Button Content="Add Nexus URL" Click="AddUrl_Click" Style="{StaticResource PrimaryButton}"/>
                                        <Button Content="Import Archive" Click="ImportArchive_Click"/>
                                        <Button Content="Deploy Queue" Click="DeploySelected_Click"/>
                                        <Button Content="Open Mods Folder" Click="OpenModsFolder_Click"/>
                                        <Button Content="Open Game Folder" Click="OpenGameFolder_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Recent activity" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl x:Name="RecentActivityList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedBrush}" Margin="0,4"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ModsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid x:Name="InstalledModsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mod" Binding="{Binding ModName}" Width="2*"/>
                                <DataGridTextColumn Header="Archive" Binding="{Binding ArchivePath}" Width="2*"/>
                                <DataGridTextColumn Header="Installed" Binding="{Binding InstalledAtUtc, StringFormat={}{0:g}}" Width="180"/>
                                <DataGridTextColumn Header="Files" Binding="{Binding DeployedFiles.Count}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                            <Button Content="Uninstall selected" Click="UninstallInstalledSelected_Click"/>
                            <Button Content="Open Mods Folder" Click="OpenModsFolder_Click"/>
                        </WrapPanel>
                    </Grid>

                    <Grid x:Name="QueuePage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid x:Name="QueueGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mod" Binding="{Binding ModName}" Width="2*"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110"/>
                                <DataGridTextColumn Header="Mod ID" Binding="{Binding ModId}" Width="80"/>
                                <DataGridTextColumn Header="File ID" Binding="{Binding FileId}" Width="80"/>
                                <DataGridTextColumn Header="Archive" Binding="{Binding ArchivePath}" Width="2*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                            <Button Content="Download missing" Click="DownloadMissing_Click" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="Open Nexus page" Click="OpenSelectedPage_Click"/>
                            <Button Content="Import archive" Click="ImportArchive_Click"/>
                            <Button Content="Delete download" Click="DeleteDownloadedArchive_Click"/>
                            <Button Content="Deploy selected" Click="DeploySelected_Click"/>
                            <Button Content="Uninstall selected" Click="UninstallSelected_Click"/>
                            <Button Content="Clear completed" Click="ClearCompleted_Click"/>
                        </WrapPanel>
                    </Grid>

                    <Grid x:Name="ModpacksPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid x:Name="ProfilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Mods" Binding="{Binding Items.Count}" Width="80"/>
                                <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAtUtc, StringFormat={}{0:g}}" Width="180"/>
                                <DataGridTextColumn Header="Profile ID" Binding="{Binding ProfileId}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBox x:Name="ProfileNameBox" Width="260" DockPanel.Dock="Left" ToolTip="Profile name"/>
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Content="Save current as new" Click="SaveProfileNew_Click" Style="{StaticResource PrimaryButton}"/>
                                <Button Content="Update selected" Click="UpdateProfileSelected_Click"/>
                                <Button Content="Load selected" Click="LoadProfileSelected_Click"/>
                                <Button Content="Activate selected" Click="ActivateProfileSelected_Click"/>
                                <Button Content="Delete selected" Click="DeleteProfileSelected_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Grid>

                    <ScrollViewer x:Name="DownloadsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Archive locations" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Manage retained downloads and browser fallback imports." Foreground="{StaticResource MutedBrush}" Margin="0,2,0,14"/>
                            <WrapPanel>
                                <Button Content="Open download folder" Click="OpenDownloadDirectory_Click"/>
                                <Button Content="Import archive" Click="ImportArchive_Click"/>
                                <Button Content="Delete selected download" Click="DeleteDownloadedArchive_Click"/>
                                <Button Content="Download missing queue items" Click="DownloadMissing_Click" Style="{StaticResource PrimaryButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Nexus API key" FontWeight="SemiBold"/>
                            <PasswordBox x:Name="ApiKeyBox"/>
                            <WrapPanel><Button Content="Save settings" Click="SaveSettings_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Get API key" Click="OpenApiKeyPage_Click"/><Button Content="Test Connection" Click="TestConnection_Click"/></WrapPanel>
                            <CheckBox x:Name="AdvancedOptionsBox" Content="Advanced options" Foreground="{StaticResource TextBrush}" Margin="0,8,0,18"/>

                            <TextBlock Text="Ready or Not install folder" FontWeight="SemiBold"/>
                            <TextBox x:Name="GameDirectoryBox"/>
                            <WrapPanel><Button Content="Choose game folder" Click="BrowseGameDirectory_Click"/><Button Content="Auto-detect Game Folder" Click="AutoDetectGameFolder_Click"/><Button Content="Open game folder" Click="OpenGameFolder_Click"/></WrapPanel>

                            <TextBlock Text="Download folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                            <TextBox x:Name="DownloadDirectoryBox"/>
                            <WrapPanel><Button Content="Choose download folder" Click="BrowseDownloadDirectory_Click"/><Button Content="Open folder" Click="OpenDownloadDirectory_Click"/></WrapPanel>

                            <TextBlock Text="Browser fallback import folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                            <TextBox x:Name="ImportDirectoryBox"/>
                            <Button Content="Choose import folder" Click="BrowseImportDirectory_Click"/>

                            <TextBlock Text="Modpack library folder" FontWeight="SemiBold" Margin="0,14,0,0"/>
                            <TextBox x:Name="ProfileLibraryDirectoryBox"/>
                            <WrapPanel><Button Content="Choose library folder" Click="BrowseProfileLibraryDirectory_Click"/><Button Content="Open library" Click="OpenProfileLibraryDirectory_Click"/></WrapPanel>

                            <Separator Margin="0,20,0,16" Background="{StaticResource LineBrush}"/>
                            <WrapPanel>
                                <Button Content="Reset setup wizard" Click="ResetSetupWizard_Click"/>
                                <Button Content="Clear user data" Click="ClearUserData_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="LogsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid x:Name="ErrorsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, StringFormat={}{0:g}}" Width="150"/>
                                <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="120"/>
                                <DataGridTextColumn Header="Mod" Binding="{Binding ModName}" Width="220"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*"/>
                                <DataGridTextColumn Header="Archive" Binding="{Binding ArchivePath}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                            <Button Content="Open Nexus page" Click="OpenErrorNexus_Click"/>
                            <Button Content="Open game folder" Click="OpenErrorGameFolder_Click"/>
                            <Button Content="Open archive folder" Click="OpenErrorArchiveFolder_Click"/>
                            <Button Content="Copy manual fix note" Click="CopyErrorManualFix_Click"/>
                            <Button Content="Clear errors" Click="ClearErrors_Click"/>
                        </WrapPanel>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Margin="0,16,0,0" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12">
                    <DockPanel LastChildFill="True">
                        <ProgressBar x:Name="OverallProgressBar" DockPanel.Dock="Left" Width="190" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,0,14,0"/>
                        <TextBlock x:Name="ProgressText" DockPanel.Dock="Left" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
